<?xml version="1.0" encoding="UTF-8"?><metadata xml:lang="en"><Esri><CreaDate>20240123</CreaDate><CreaTime>20460100</CreaTime><ArcGISFormat>1.0</ArcGISFormat><ArcGISProfile>NAP</ArcGISProfile><DataProperties><itemProps><portalDetails><thumbnailURL>https://www.arcgis.com/sharing/rest/content/items/a642dbaf49fe456e9110392d3dcf4bfd/info/thumbnail/thumbnail1764719361004.png</thumbnailURL><itemDetailsURL>https://www.arcgis.com/home/item.html?id=a642dbaf49fe456e9110392d3dcf4bfd</itemDetailsURL><itemType>Feature Service</itemType><resourceURL>https://services7.arcgis.com/ajJK0gHOQuH68xkx/arcgis/rest/services/2012 Arctic Medical Facilities/FeatureServer</resourceURL><itemIdentifier>a642dbaf49fe456e9110392d3dcf4bfd</itemIdentifier></portalDetails></itemProps></DataProperties><ModDate>20250220</ModDate><ModTime>20460100</ModTime></Esri><dataIdInfo><idAbs>&lt;p&gt;This information was compiled to support field research logistics in the Arctic region. &amp;nbsp;&lt;span&gt;The Arctic Medical Facilities data contains information on emergency medical facilities in remote Arctic research hubs. Information includes the location of the facility, the name, address, phone number, website, access (Airport, Heliport, Unknown), level of care (Clinic, Hospital with Rotation Doctor, Full Service Hospital), and notes on access or care provided. This data is to aid logistic planers supporting Arctic research in accessing emergency medical care for the projects they support.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;The service is embedded in an ESRI Experience Builder application. &amp;nbsp;The application is mirrored to support browse only access (https://experience.arcgis.com/experience/331a3a3c70d24544b80aa83a136a5a6f) and to allow for edit of the information by approved data stewards (https://experience.arcgis.com/experience/a9b4461a2610490d84593fe2bd20b4bb).&lt;/p&gt;</idAbs><idCitation><resTitle Sync="FALSE">Arctic Medical Facilities</resTitle><date><createDate>2025-01-31T00:00:00</createDate></d